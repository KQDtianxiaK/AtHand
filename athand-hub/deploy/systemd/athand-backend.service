[Unit]
Description=AtHand Hub Backend
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/athand-hub/backend
ExecStart=/opt/athand-hub/backend/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
