# AtHand Hub 配置

# ============ 后端 ============
# 服务端口
BACKEND_PORT=8000
# JWT 密钥（部署时请更换为随机字符串）
JWT_SECRET=change-me-to-a-random-secret
# 管理员密码（首次登录使用）
ADMIN_PASSWORD=admin123
# 数据库路径
DATABASE_URL=sqlite:///./data/athand.db
# 数据目录
DATA_DIR=./data

# ============ Agent Daemon ============
# Agent 连接预共享 Token（ECS 端和 Daemon 端需一致）
AGENT_TOKEN=change-me-to-a-random-token

# ============ AI Control Bridge（Paseo sidecar）============
# 默认连接本机 paseo daemon；backend 会自动补成 ws://127.0.0.1:6767/ws
AI_CONTROL_DEFAULT_DAEMON_URL=http://127.0.0.1:6767
# 可选：显式指定 backend 连接 paseo 时使用的 client id
AI_CONTROL_DEFAULT_CLIENT_ID=athand-backend
# 可选：多机映射，格式 machine-id=http://host:port,machine-2=http://host:port
# AI_CONTROL_MACHINE_DAEMONS=

# ============ Cloudflare Tunnel（部署时配置）============
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# ============ 邮箱（Phase 4 配置）============
# GMAIL_USER=
# GMAIL_APP_PASSWORD=
# QQ_MAIL_USER=
# QQ_MAIL_AUTH_CODE=
